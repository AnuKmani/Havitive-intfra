# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://shybzcfybjhpnxadkdyf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public address of the site, used for canonical URLs, the sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://havitive.com

# Claude API key for the "Ask Havi" chat assistant (console.anthropic.com)
ANTHROPIC_API_KEY=

# Email (optional) – new application / enquiry alerts and replies to applicants from the admin.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail address>, SMTP_PASS=<16-letter App Password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "Havitive Careers <havitiveinfra@gmail.com>" (defaults to SMTP_USER)
MAIL_FROM=
# Where new-application and enquiry alerts are sent (defaults to havitiveinfra@gmail.com)
NOTIFY_EMAIL=
